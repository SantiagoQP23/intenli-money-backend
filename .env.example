APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://intenli:intenli@localhost:5432/intenli?sslmode=disable
# Defaults to true in development, false in production.
AUTO_MIGRATE=true
LOG_LEVEL=debug
# Comma-separated browser origins (Expo web). Defaults to http://localhost:8081 in development.
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Signs access tokens. Required (32+ chars) in production: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
INVITATION_TTL=168h
# Comma-separated Google OAuth client IDs (iOS, Android, web). Empty disables Google sign-in.
GOOGLE_CLIENT_IDS=
# Requests per minute per IP on /v1/auth (0 disables).
AUTH_RATE_LIMIT=20
